# Site (Astro, Cloudflare Pages)
PUBLIC_SITE_URL=https://<ton-domaine>
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Token preview : serveur uniquement, jamais expose au client
SANITY_PREVIEW_TOKEN=

# Studio Sanity (sanity/ : `sanity dev` / `sanity deploy`)
# Recopier le projectId ci-dessus. Dataset : production.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# URL publique de la vitrine (lien « Voir le site » dans l'accueil du Studio).
SANITY_STUDIO_SITE_URL=
